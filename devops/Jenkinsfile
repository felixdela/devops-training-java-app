def runInDocker(String image, Closure body) {
  docker.image(image).inside {
    body()
  }
}

pipeline {
  agent any
  
  parameters {
    booleanParam (
    	name: 'RUN_CD',
			defaultValue: false,
			description: 'Forzar ejecución del stage CD'
		)	
	}
	
  stages {
		stage('Build CI image') {
			steps {
			  script {
			    docker.build(
			env.CI_IMAGE_NAME,
			"-f devops/ci.Dockerfile ."
			    )
			  }
			}
		}
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    stage('Lint') {
      steps {
        script {
          runInDocker('maven:3.8.6-openjdk-11-slim') {
            sh 'make lint'
          }
        }
      }
    }

    stage('Test') {
      steps {
        script {
          runInDocker('maven:3.8.6-openjdk-11-slim') {
            sh 'make test'
          }
        }
      }
    }
    stage('Build image') {
      steps {
        script {
          def version = env.BUILD_NUMBER
          def image = docker.build(
            "devops-training-java-app:${version}",
            "--build-arg VERSION=${version} -f devops/Dockerfile ."
          )
          echo "Imagen construida: ${image.imageName()}"
        }
      }
    }
    stage('CD') {
      when {
        anyOf {
          expression { return params.RUN_CD }
          branch 'develop'
          branch 'master'
        }
      }
      steps {
        echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"
      }
    }
  }
}

