def runInDocker(String image, Closure body) {
  docker.image(image).inside {
    body()
  }
}

pipeline {
  agent any

  stages {
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    stage('Lint') {
      steps {
        script {
          runInDocker('maven:3.8.6-openjdk-11-slim') {
            sh 'apt-get update && apt-get install -y make'
            sh 'make lint'
          }
        }
      }
    }

    stage('Test') {
      steps {
        script {
          runInDocker('maven:3.8.6-openjdk-11-slim') {
            sh 'apt-get update && apt-get install -y make'
            sh 'make test'
          }
        }
      }
    }

    stage('Build image') {
      steps {
        script {
          def version = env.BUILD_NUMBER
          def image = docker.build(
            "devops-training-java-app:${version}",
            "--build-arg VERSION=${version} -f devops/Dockerfile ."
          )
          echo "Imagen construida: ${image.imageName()}"
        }
      }
    }
  }
}

